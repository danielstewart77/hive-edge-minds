# hive-edge-minds — secrets and per-host wiring.
# Copy to .env, fill in real values, then: chmod 600 .env
# setup.sh does the copy and stamps MIND_NAME / MIND_ID / MIND_SERVER_PORT.

# --- Identity -------------------------------------------------------------
# Display name (logs, paths). Never written to the hive's memory.
MIND_NAME=example
# The identity every memory write carries. Generate once: uuidgen
MIND_ID=
MIND_SERVER_PORT=8421

# --- The hive (containers from the hive-mind repo) ------------------------
# hive-comms: gateway — session manager, broker, HITL.
COMMS_URL=http://127.0.0.1:8426
COMMS_BEARER_TOKEN=
# Admin bearer. This mind registers itself with the broker from its own
# runtime.yaml on every start, which is an admin route; it is also the
# token the hive console presents to write PATCH /runtime here, unless
# MIND_ADMIN_TOKEN is set to a dedicated one.
COMMS_ADMIN_BEARER_TOKEN=
MIND_ADMIN_TOKEN=
# hive-lucent: memory — vector store + knowledge graph.
LUCENT_URL_SELF=http://127.0.0.1:8425
LUCENT_BEARER_TOKEN=

# --- Optional hive services ----------------------------------------------
# hive-tools (Ollama classifier + integrations) — used by memory hooks.
HIVE_TOOLS_URL=
HIVE_TOOLS_TOKEN=
# Voice server (STT/TTS) — required for voice notes and the wake-word app.
VOICE_SERVER_URL=

# --- Surfaces -------------------------------------------------------------
# Telegram bot token from @BotFather. Each mind needs its own bot.
TELEGRAM_BOT_TOKEN=
# Voice every conversational reply (text still streams; a voice note
# follows). 0 = text-only unless the user sends a voice message.
ALWAYS_VOICE=1
# Discord (only if the discord surface is enabled)
DISCORD_BOT_TOKEN=

# --- Harness (codex minds only) -------------------------------------------
# Codex config/state root (config.toml, auth.json, session rollouts).
# Defaults to ~/.codex when unset.
#CODEX_HOME=
# Optional codex config profile ([profiles.<name>] in config.toml).
#CODEX_PROFILE=
# Reap a codex turn after this many seconds of total silence.
#CODEX_TURN_IDLE_TIMEOUT=300

# --- Terminal / misc ------------------------------------------------------
# Label shown for the user's side when Telegram turns mirror into an open
# browser-terminal tile.
OWNER_NAME=user
# Idle browser-terminal reaper (seconds unattached before the tmux session
# is reaped). Default one hour.
#PTY_IDLE_TIMEOUT_SECONDS=3600

# --- Windows (windows-task deployment only) -------------------------------
# os.pathsep-separated dirs prepended to PATH by launch_windows.py — e.g. a
# standalone codex.exe install dir.
#WINDOWS_PATH_PREPEND=

# --- SMTP fallback for notifications (optional) ---------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TO=
