sessions.db.*.bak
sessions.db.pre-*.bak
data/*
!data/.gitkeep

# Planning documents (local working files, not versioned)
plans/

# npm packages (installed by skills/tools at runtime)
.npm_packages/
node_modules/

# Project config (user-specific or contains sensitive IDs)
config.yaml
.mcp.json
.mcp.container.json
docker-compose.override.yml
docker-compose.production.yml

# Local tool state
.claude/
.codex/
.obsidian/
.log_agent_positions

# Your minds are your own — per-host identity, never pushed.
# The tracked exceptions are the package init and the example contract.
minds/*
!minds/__init__.py
!minds/example/

# Your souls are your own — only the example template is tracked.
souls/*
!souls/example.md

# Generated output artifacts
*-report.md
reports/

# Voice source clips — keep local only
voice/*.wav
voice/*.mp3
voice/*.ogg


# Editor backups
*~
*.swp
backups/

# Story files (working docs, not for GitHub)
/stories/

# Personal reminders (local only) — anchored so tools/stateless/reminders/ stays tracked
/reminders/

# Env backups (any timestamp)
.env.backup-*
.env.bak*
.vscode/
