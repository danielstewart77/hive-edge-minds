# hive-edge-minds configuration.
# Copy to config.yaml. Non-secret settings only — secrets stay in .env.

server_port: 8421
default_model: sonnet

# Autopilot guard rails
autopilot_guards:
  max_budget_usd: 5.00
  max_turns_without_input: 50
  max_minutes_without_input: 30

# Providers — env overrides applied per-subprocess, not globally.
#
# The provider is orthogonal to the harness: either harness runs against
# either provider. The claude harness needs only the ANTHROPIC_* env below;
# the codex harness additionally emits `-c model_providers.*` flags built
# from OLLAMA_BASE_URL (codex has no base-URL env var of its own).
#
# If OPENAI_API_KEY is set, codex declares env_key and sends a bearer token —
# right for a metering proxy in front of Ollama, unnecessary for bare Ollama.
providers:
  anthropic: {}
  openai: {}
  ollama:
    env:
      ANTHROPIC_AUTH_TOKEN: "ollama"
      ANTHROPIC_API_KEY: ""
      ANTHROPIC_BASE_URL: "http://your-ollama-host:11434"
      OLLAMA_BASE_URL: "http://your-ollama-host:11434/v1"
      OPENAI_API_KEY: ""
    api_base: "http://your-ollama-host:11434"


# Telegram — user allowlist (get your ID from @userinfobot)
telegram_allowed_users:
  - 0000000000
telegram_owner_chat_id: 0000000000  # DM chat ID for owner notifications

# Discord (only if the discord surface is enabled)
discord_allowed_users: []
discord_allowed_channels: []  # empty = all channels + DMs
